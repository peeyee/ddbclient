{
    "configurations": [
        {
            "name": "ubuntu",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/thirdparty/linenoise-ng/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}